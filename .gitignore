# AI assistant tooling (kept local, not published) — except the shared project
# skills, which live in .agents/skills/{printstash,create-tests}/. That is the
# source of truth for every assistant; .claude/skills is a tracked symlink to it,
# so a fresh clone works for Claude Code without a second copy to keep in sync.
.codex/
.mcp.json
.claude/*
!.claude/skills
.opencode/
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/printstash/
!.agents/skills/create-tests/
skills-lock.json
docs/agents/
frontend/test-results/
frontend/playwright-report/
frontend/tests/e2e-real/.data/
.playwright-mcp/
screenshots/gif-frames/

# Local integration worktrees
.cloud-integration-*/

# Windows "downloaded from internet" metadata streams (WSL surfaces these)
*:Zone.Identifier

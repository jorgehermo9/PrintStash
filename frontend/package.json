{
  "name": "printstash-frontend",
  "version": "0.12.1",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "start": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit && pnpm --filter @printstash/ui typecheck && pnpm --filter @printstash/domain typecheck",
    "test": "vitest run && pnpm --filter @printstash/ui test && pnpm --filter @printstash/domain test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test --config=playwright.real.config.ts",
    "test:frontend": "node scripts/frontend-smoke.mjs",
    "media:readme": "node scripts/generate-readme-media.mjs",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@printstash/domain": "workspace:*",
    "@printstash/ui": "workspace:*",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-separator": "^1.1.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@types/three": "0.182.0",
    "lucide-react": "^1.17.0",
    "pdfjs-dist": "5.4.296",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.8.1",
    "rehype-sanitize": "^6.0.0",
    "sonner": "^2.0.7",
    "tailwindcss-animate": "^1.0.7",
    "three": "0.182.0",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@playwright/test": "1.60.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "10.5.0",
    "jsdom": "^29.1.1",
    "oxc-parser": "0.146.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "postcss": "8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@10.18.1",
  "pnpm": {
    "overrides": {
      "three": "0.182.0"
    }
  }
}
